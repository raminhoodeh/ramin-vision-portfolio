{
  "name": "ramin-portfolio",
  "version": "1.0.0",
  "description": "Ramin Hoodeh — AI Product Manager Portfolio",
  "type": "module",
  "scripts": {
    "dev": "npm run build:ai-ramin-corpus && vite --host 127.0.0.1 --port 4182 --strictPort",
    "build": "npm run build:ai-ramin-corpus && vite build",
    "start": "node server.mjs",
    "preview": "vite preview",
    "build:ai-ramin-corpus": "node scripts/build-ai-ramin-corpus.mjs",
    "check:ai-ramin-corpus": "node scripts/build-ai-ramin-corpus.mjs --check",
    "check:ai-ramin-eval": "node scripts/evaluate-ai-ramin.mjs",
    "check:ai-ramin-routing": "node scripts/check-ai-ramin-interview-routing.mjs",
    "check:ai-ramin-routing-observability": "node scripts/check-ai-ramin-routing-observability.mjs",
    "check:ai-ramin-intent-contract": "node scripts/check-ai-ramin-intent-router-contract.mjs",
    "check:ai-ramin-intent-classifier": "node scripts/check-ai-ramin-intent-classifier-contract.mjs",
    "check:ai-ramin-conversation-context": "node scripts/check-ai-ramin-conversation-context-contract.mjs",
    "check:ai-ramin-clarification-routing": "node scripts/check-ai-ramin-clarification-routing-contract.mjs",
    "check:ai-ramin-prompt": "node scripts/check-ai-ramin-prompt-contract.mjs",
    "check:ai-ramin-ui-copy": "node scripts/check-ai-ramin-ui-copy-contract.mjs",
    "check:ai-ramin-weak-ui": "node scripts/check-ai-ramin-weak-answer-ui-contract.mjs",
    "check:ai-ramin-feedback": "node scripts/check-ai-ramin-feedback-contract.mjs",
    "check:ai-ramin-review": "node scripts/check-ai-ramin-feedback-review-contract.mjs",
    "evaluate:ai-ramin": "node scripts/evaluate-ai-ramin.mjs --write-report --log-failures",
    "review:ai-ramin-feedback": "node scripts/review-ai-ramin-feedback.mjs",
    "check:content": "node scripts/check-content-model.mjs",
    "check:rock-assets": "node scripts/check-hashgraph-rock-assets.mjs",
    "check:performance-guardrails": "node scripts/check-performance-guardrails.mjs",
    "check:preview": "node scripts/check-preview.mjs",
    "verify": "npm run check:content && npm run check:ai-ramin-corpus && npm run check:ai-ramin-eval && npm run check:ai-ramin-routing && npm run check:ai-ramin-routing-observability && npm run check:ai-ramin-intent-contract && npm run check:ai-ramin-intent-classifier && npm run check:ai-ramin-conversation-context && npm run check:ai-ramin-clarification-routing && npm run check:ai-ramin-prompt && npm run check:ai-ramin-ui-copy && npm run check:ai-ramin-weak-ui && npm run check:ai-ramin-feedback && npm run check:ai-ramin-review && npm run build && npm run check:rock-assets && npm run check:performance-guardrails",
    "verify:preview": "npm run verify && npm run check:preview"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@react-spring/three": "^10.0.3",
    "@react-three/fiber": "^9.6.1",
    "@shadergradient/react": "^2.4.20",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "camera-controls": "^3.1.2",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "hls.js": "^1.6.16",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.172.0",
    "three-stdlib": "^2.36.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@gltf-transform/cli": "^4.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "vite": "^8.0.12"
  }
}
