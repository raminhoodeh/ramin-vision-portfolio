        "intent": "casual_chat",
        "confidence": 0.48,
        "isSubstantive": false,
        "needsEvidence": false,
        "needsRetrieval": false,
        "needsStructuredModules": false,
        "suggestedTone": "casual",
        "reason": "casual acknowledgement"
      },
      "defaultThreshold": 0.62,
      "expectedAcceptanceThreshold": 0.45,
      "expectedAccepted": true,
      "expectedQuestionType": "conversation_open",
      "expectedNeedsRetrieval": false
    },
    {
      "id": "below-calibrated-casual-acknowledgement",
      "prompt": "ok cool thanks",
      "requestType": "general_chat",
      "expectedDeterministicQuestionType": "portfolio_overview",
