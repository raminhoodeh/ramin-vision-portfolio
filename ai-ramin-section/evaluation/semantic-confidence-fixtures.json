{
  "schemaVersion": 1,
  "description": "Stage 6 fixtures for intent-aware semantic classifier confidence. These cases prevent moderate-confidence casual or professional classifications from falling back to portfolio_overview just because deterministic routing was weak.",
  "cases": [
    {
