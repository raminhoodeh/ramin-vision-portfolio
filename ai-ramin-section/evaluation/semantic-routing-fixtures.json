{
  "schemaVersion": 1,
  "description": "Stage 5 fixtures for semantic intent routing. These cases validate that the AI classifier, not portfolio-overview fallthrough, separates casual chat from professional portfolio requests.",
  "cases": [
    {
      "id": "social-thanks",
      "prompt": "thanks, that's helpful",
      "requestType": "general_chat",
      "classifierPayload": {
        "intent": "casual_chat",
        "confidence": 0.97,
        "isSubstantive": false,
        "needsEvidence": false,
        "needsRetrieval": false,
        "needsStructuredModules": false,
        "suggestedTone": "casual",
        "reason": "visitor acknowledgement, not a portfolio request"
      },
      "expectedIntent": "casual_chat",
      "expectedQuestionType": "conversation_open",
      "expectedSuggestedTone": "casual",
      "expectedNeedsRetrieval": false,
      "expectedShowEvidenceDisclosure": false
    },
    {
