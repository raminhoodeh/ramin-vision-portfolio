{
  "framework": null,
  "buildCommand": "npm run build",
  "routes": [
    {
      "src": "^/$",
      "caseSensitive": true,
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; connect-src 'none'; style-src 'unsafe-inline'; font-src 'self'; img-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
        "X-Portfolio-Availability": "maintenance"
      }
    },
    {
      "src": "^/robots\\.txt$",
      "caseSensitive": true,
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/robots.txt",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; connect-src 'none'; style-src 'unsafe-inline'; font-src 'self'; img-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
        "X-Portfolio-Availability": "maintenance"
      }
    },
    {
      "src": "^/_maintenance/proofs\\.js$",
      "caseSensitive": true,
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/_maintenance/proofs.js",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; connect-src 'none'; style-src 'unsafe-inline'; font-src 'self'; img-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
        "X-Portfolio-Availability": "maintenance",
        "Content-Type": "text/javascript; charset=utf-8"
      }
    },
    {
      "src": "^/_maintenance/background\\.js$",
      "caseSensitive": true,
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/_maintenance/background.js",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; connect-src 'none'; style-src 'unsafe-inline'; font-src 'self'; img-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
        "X-Portfolio-Availability": "maintenance",
        "Content-Type": "text/javascript; charset=utf-8"
      }
    },
    {
      "src": "^/_maintenance/inter-latin\\.woff2$",
      "caseSensitive": true,
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/_maintenance/inter-latin.woff2",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; connect-src 'none'; style-src 'unsafe-inline'; font-src 'self'; img-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
        "X-Portfolio-Availability": "maintenance",
        "Content-Type": "font/woff2"
      }
    },
    {
      "src": "^/_maintenance/instrument-serif-italic-latin\\.woff2$",
      "caseSensitive": true,
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/_maintenance/instrument-serif-italic-latin.woff2",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; connect-src 'none'; style-src 'unsafe-inline'; font-src 'self'; img-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
        "X-Portfolio-Availability": "maintenance",
        "Content-Type": "font/woff2"
      }
    },
    {
      "src": "^/.*$",
      "status": 503,
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; connect-src 'none'; style-src 'unsafe-inline'; font-src 'self'; img-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
        "X-Portfolio-Availability": "maintenance",
        "Retry-After": "86400"
      }
    }
  ]
}
